# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://toodooloo:toodooloo@localhost:5433/toodooloo?schema=public"

# Public URL of the app, used in password reset links
APP_URL="http://localhost:3000"

# Optional. Without these, reset emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Toodooloo <onboarding@resend.dev>"
